# Salin menjadi .env.local (untuk lokal) atau isi di Vercel -> Settings -> Environment Variables
# Ambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Pakai "anon" / "publishable" key. JANGAN pakai service_role key di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_key_di_sini
